rules_version = '2';

// Firestore security rules for Koru.
//
// Coverage:
//   /waitlist/{docId}                    — public create (validated), no read
//   /users/{uid}/profile/main            — authenticated owner only
//   /users/{uid}/quizResults/{resultId}  — authenticated owner: read + validated create; no update/delete
//   /users/{uid}/subscription/main       — authenticated owner only
//   everything else                      — deny all
//
// "Owner" means: request.auth != null && request.auth.uid == uid
// Admin reads (e.g. the /api/admin/users endpoint) use Firebase Admin SDK server-side
// and bypass these rules entirely — no client-side admin access to other users' data.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Waitlist ──────────────────────────────────────────────────────────────
    // Anyone may submit an email to the waitlist (create only).
    // Fields are strictly validated; reads are blocked (use Admin SDK server-side).
    match /waitlist/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['email', 'createdAt', 'referralCode', 'userAgent']) &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.referralCode is string &&
        request.resource.data.referralCode.matches('^[A-Z0-9]{6,12}$') &&
        request.resource.data.userAgent is string &&
        request.resource.data.userAgent.size() > 0 &&
        request.resource.data.userAgent.size() <= 512;

      allow read: if false;
    }

    // ── User profile ──────────────────────────────────────────────────────────
    // Stored at /users/{uid}/profile/main (single document per user).
    // Only the owning authenticated user may read or write their own profile.
    match /users/{uid}/profile/main {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Quiz results ──────────────────────────────────────────────────────────
    // Each quiz result is an immutable record created once.
    // Owners may read their results; they may create new ones (with required fields);
    // update and delete are permanently blocked to preserve history.
    match /users/{uid}/quizResults/{resultId} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['quizId', 'quizTitle', 'resultTypeId', 'resultTitle', 'resultEmoji', 'completedAt'])
        && request.resource.data.quizId is string
        && request.resource.data.resultTypeId is string;

      allow update, delete: if false;
    }

    // ── Subscription ──────────────────────────────────────────────────────────
    // Stored at /users/{uid}/subscription/main (single document per user).
    // Only the owning authenticated user may read or write their subscription status.
    // Subscription is also written server-side via Admin SDK after payment verification.
    match /users/{uid}/subscription/main {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Everything else: deny ─────────────────────────────────────────────────
    // Catch-all explicit deny. Any collection not listed above is inaccessible
    // to all clients, regardless of auth state.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
