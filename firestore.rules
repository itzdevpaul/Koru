rules_version = '2';

// Firestore security rules for Koru.
//
// Coverage:
//   /waitlist/{docId}                    — public create (validated), no read
//   /users/{uid}/profile/main            — owner read/write; admin read
//   /users/{uid}/quizResults/{resultId}  — owner read + validated create; admin read; no update/delete
//   /users/{uid}/subscription/main       — owner read/write; admin read
//   /users/{uid}/checkins/{dateId}       — owner read/create/update; admin read; no delete
//   everything else                      — deny all
//
// "Owner" means: request.auth != null && request.auth.uid == uid
// "Admin" means: authenticated as pauladamu600@gmail.com (verified via Google Sign-In)
// Heavy admin operations (e.g. listing all users) use Firebase Admin SDK server-side
// and bypass these rules entirely.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: admin check ───────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'pauladamu600@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Waitlist ──────────────────────────────────────────────────────────────
    // Anyone may submit an email to the waitlist (create only).
    // Fields are strictly validated; reads are blocked (use Admin SDK server-side).
    match /waitlist/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['email', 'createdAt', 'referralCode', 'userAgent']) &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.referralCode is string &&
        request.resource.data.referralCode.matches('^[A-Z0-9]{6,12}$') &&
        request.resource.data.userAgent is string &&
        request.resource.data.userAgent.size() > 0 &&
        request.resource.data.userAgent.size() <= 512;

      allow read: if isAdmin();
    }

    // ── User profile ──────────────────────────────────────────────────────────
    // Stored at /users/{uid}/profile/main (single document per user).
    // Owner may read and write. Admin may read any profile.
    match /users/{uid}/profile/main {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'focusAreas', 'ageRange', 'onboardingComplete',
          'streak', 'lastActive', 'emailOptIn', 'lastReminderSent',
          'pushNotificationsEnabled', 'pushToken', 'lastClarityCardSeen',
          'currentIntention', 'intentionSetAt', 'intentionSurfacedAt', 'updatedAt'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'focusAreas', 'ageRange', 'onboardingComplete',
          'streak', 'lastActive', 'emailOptIn', 'lastReminderSent',
          'pushNotificationsEnabled', 'pushToken', 'lastClarityCardSeen',
          'currentIntention', 'intentionSetAt', 'intentionSurfacedAt', 'updatedAt'
        ]);
    }

    // ── Quiz results ──────────────────────────────────────────────────────────
    // Each quiz result is an immutable record created once.
    // Owners may read their results and create new ones (with required fields).
    // Admin may read any result. Update and delete are permanently blocked.
    match /users/{uid}/quizResults/{resultId} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['quizId', 'quizTitle', 'resultTypeId', 'resultTitle', 'resultEmoji', 'completedAt'])
        && request.resource.data.quizId is string
        && request.resource.data.resultTypeId is string;

      allow update, delete: if false;
    }

    // ── Subscription ──────────────────────────────────────────────────────────
    // Stored at /users/{uid}/subscription/main (single document per user).
    // Owner may read and write. Admin may read. Server-side Admin SDK handles
    // subscription activation after payment verification.
    match /users/{uid}/subscription/main {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── Check-ins ─────────────────────────────────────────────────────────────
    // Stored at /users/{uid}/checkins/{YYYY-MM-DD} — one document per day.
    // Owners may read, create, and update their own check-ins. Admin may read.
    // Deletes are blocked for everyone.
    match /users/{uid}/checkins/{dateId} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['mood', 'energy', 'reflection', 'prompt', 'createdAt'])
        && request.resource.data.mood is string
        && request.resource.data.mood in ['thriving', 'good', 'okay', 'low', 'rough']
        && request.resource.data.energy is int
        && request.resource.data.energy >= 1
        && request.resource.data.energy <= 5
        && request.resource.data.reflection is string
        && request.resource.data.reflection.size() <= 1000
        && request.resource.data.prompt is string;

      allow update: if isOwner(uid)
        && request.resource.data.mood is string
        && request.resource.data.mood in ['thriving', 'good', 'okay', 'low', 'rough']
        && request.resource.data.energy is int
        && request.resource.data.energy >= 1
        && request.resource.data.energy <= 5;

      allow delete: if false;
    }

    // ── Ads ───────────────────────────────────────────────────────────────────
    // /ads/{adId} — admin full CRUD; any authenticated user may read active ads
    // (getActiveAd is called client-side for free users on the Home dashboard).
    match /ads/{adId} {
      // Any authenticated user can read individual ad documents (needed for
      // the active-ad query on the Home page).
      allow read: if request.auth != null;

      // Only admin may create, update, or delete ads.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'description', 'ctaText', 'ctaLink', 'imageBase64', 'active', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.ctaLink is string
        && request.resource.data.active is bool;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Everything else: deny ─────────────────────────────────────────────────
    // Catch-all explicit deny. Any collection not listed above is inaccessible
    // to all clients, regardless of auth state.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
