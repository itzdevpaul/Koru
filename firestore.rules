rules_version = '2';

// Firestore security rules for Koru.
//
// Coverage:
//   /users/{uid}/profile/main            — owner read/write; admin read
//   /users/{uid}/quizResults/{resultId}  — owner read + validated create; admin read; no update/delete
//   /users/{uid}/subscription/main       — owner read/write; admin read
//   /users/{uid}/checkins/{dateId}       — owner read/create/update; admin read; no delete
//   everything else                      — deny all
//
// "Owner" means: request.auth != null && request.auth.uid == uid
// "Admin" means: authenticated as pauladamu600@gmail.com (verified via Google Sign-In)
// Heavy admin operations (e.g. listing all users) use Firebase Admin SDK server-side
// and bypass these rules entirely.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: admin check ───────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'pauladamu600@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasValidWhatsAppContact(data) {
      return data.whatsappNumber is string
        && data.whatsappNumber.matches('^\\+[1-9][0-9]{7,14}$')
        && data.whatsappOptIn is bool
        && data.whatsappConsentAt is string
        && data.whatsappConsentAt.size() <= 40;
    }

    // ── User profile ──────────────────────────────────────────────────────────
    // Stored at /users/{uid}/profile/main (single document per user).
    // Owner may read and write. Admin may read any profile.
    match /users/{uid}/profile/main {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'focusAreas', 'ageRange', 'onboardingComplete',
          'streak', 'lastActive', 'emailOptIn', 'lastReminderSent',
          'pushNotificationsEnabled', 'pushToken', 'pushCheckInReminders', 'pushJournalPrompts', 'pushQuizNudges', 'pushProgressUpdates', 'lastClarityCardSeen',
           'currentIntention', 'intentionSetAt', 'intentionSurfacedAt',
           'whatsappNumber', 'whatsappOptIn', 'whatsappConsentAt', 'updatedAt'
         ])
        && (!request.resource.data.keys().hasAny([
          'whatsappNumber', 'whatsappOptIn', 'whatsappConsentAt'
        ]) || hasValidWhatsAppContact(request.resource.data));
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'focusAreas', 'ageRange', 'onboardingComplete',
          'streak', 'lastActive', 'emailOptIn', 'lastReminderSent',
          'pushNotificationsEnabled', 'pushToken', 'pushCheckInReminders', 'pushJournalPrompts', 'pushQuizNudges', 'pushProgressUpdates', 'lastClarityCardSeen',
           'currentIntention', 'intentionSetAt', 'intentionSurfacedAt',
           'whatsappNumber', 'whatsappOptIn', 'whatsappConsentAt', 'updatedAt'
         ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'whatsappNumber', 'whatsappOptIn', 'whatsappConsentAt'
        ]) || hasValidWhatsAppContact(request.resource.data));
    }

    // ── Quiz results ──────────────────────────────────────────────────────────
    // Each quiz result is an immutable record created once.
    // Owners may read their results and create new ones (with required fields).
    // Admin may read any result. Update and delete are permanently blocked.
    match /users/{uid}/quizResults/{resultId} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['quizId', 'quizTitle', 'resultTypeId', 'resultTitle', 'resultEmoji', 'completedAt'])
        && request.resource.data.keys().hasAll(['quizId', 'quizTitle', 'resultTypeId', 'resultTitle', 'resultEmoji', 'completedAt'])
        && request.resource.data.quizId is string
        && request.resource.data.quizId.size() <= 100
        && request.resource.data.quizTitle is string
        && request.resource.data.quizTitle.size() <= 160
        && request.resource.data.resultTypeId is string
        && request.resource.data.resultTypeId.size() <= 100
        && request.resource.data.resultTitle is string
        && request.resource.data.resultTitle.size() <= 160
        && request.resource.data.resultEmoji is string
        && request.resource.data.resultEmoji.size() <= 16;

      allow update, delete: if false;
    }

    // ── Private journal ───────────────────────────────────────────────────────
    // Journal text is encrypted in the browser before it is stored.
    match /users/{uid}/journal/{entryId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'title', 'contentEnc', 'linkedQuizId', 'linkedCheckInDate', 'linkedIntention', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.contentEnc is map
        && request.resource.data.contentEnc.keys().hasOnly(['c', 'i'])
        && request.resource.data.contentEnc.c is string
        && request.resource.data.contentEnc.i is string;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'contentEnc', 'linkedQuizId', 'linkedCheckInDate', 'linkedIntention', 'updatedAt'
        ]);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── Subscription ──────────────────────────────────────────────────────────
    // Stored at /users/{uid}/subscription/main (single document per user).
    // Owner may read and write. Admin may read. Server-side Admin SDK handles
    // subscription activation after payment verification.
    match /users/{uid}/subscription/main {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── Check-ins ─────────────────────────────────────────────────────────────
    // Stored at /users/{uid}/checkins/{YYYY-MM-DD} — one document per day.
    // Owners may read, create, and update their own check-ins. Admin may read.
    // Deletes are blocked for everyone.
    match /users/{uid}/checkins/{dateId} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['mood', 'energy', 'reflection', 'reflectionEnc', 'prompt', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['mood', 'energy', 'prompt', 'createdAt'])
        && request.resource.data.keys().hasAny(['reflection', 'reflectionEnc'])
        && (!request.resource.data.keys().hasAny(['reflection']) || (request.resource.data.reflection is string && request.resource.data.reflection.size() <= 1000))
        && (!request.resource.data.keys().hasAny(['reflectionEnc']) || (request.resource.data.reflectionEnc is map && request.resource.data.reflectionEnc.keys().hasOnly(['c', 'i'])))
        && request.resource.data.mood is string
        && request.resource.data.mood in ['thriving', 'good', 'okay', 'low', 'rough']
        && request.resource.data.energy is int
        && request.resource.data.energy >= 1
        && request.resource.data.energy <= 5
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() <= 500;

      allow update: if isOwner(uid)
        && request.resource.data.mood is string
        && request.resource.data.mood in ['thriving', 'good', 'okay', 'low', 'rough']
        && request.resource.data.energy is int
        && request.resource.data.energy >= 1
        && request.resource.data.energy <= 5;

      allow delete: if false;
    }

    // ── One-time unlocks ───────────────────────────────────────────────────────
    match /users/{uid}/unlocks/{quizId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── Mood matches ──────────────────────────────────────────────────────────
    match /users/{uid}/moodMatches/{matchId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['feelingId', 'quizId', 'completedAt'])
        && request.resource.data.feelingId is string
        && request.resource.data.quizId is string;
      allow update, delete: if false;
    }

    // ── Funnel analytics ──────────────────────────────────────────────────────
    match /funnelEvents/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['type', 'uid', 'page', 'metadata', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 80
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 200;
      allow read, update, delete: if isAdmin();
    }

    // Public reflections contain no identity-bearing fields and are immutable.
    match /anonymizedReflections/{reflectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow update, delete: if false;
    }

    // ── Ads ───────────────────────────────────────────────────────────────────
    // /ads/{adId} — admin full CRUD; any authenticated user may read active ads
    // (getActiveAd is called client-side for free users on the Home dashboard).
    match /ads/{adId} {
      // Any authenticated user can read individual ad documents (needed for
      // the active-ad query on the Home page).
      allow read: if request.auth != null;

      // Only admin may create, update, or delete ads.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'description', 'ctaText', 'ctaLink', 'imageBase64', 'active', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.ctaLink is string
        && request.resource.data.active is bool;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Notifications ──────────────────────────────────────────────────────────
    // /users/{uid}/notifications/{notificationId} — created server-side (Admin SDK)
    // when someone uses the owner's invite code. Owner may read; admin may read.
    // Client writes are blocked (notifications are server-managed).
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── Everything else: deny ─────────────────────────────────────────────────
    // Catch-all explicit deny. Any collection not listed above is inaccessible
    // to all clients, regardless of auth state.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
